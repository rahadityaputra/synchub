# Jangan kirim ke Cloud Build / App Engine
node_modules/
.git/
.github/
.vscode/
.idea/
*.log

# .env tidak perlu dikirim — nilai diambil dari Secret Manager saat build
.env
.env.local
.env.*.local

# Map files tidak diperlukan
*.js.map

# dist/ tidak diignore karena Cloud Build generate dist/ terlebih dahulu,
# lalu gcloud app deploy perlu meng-upload dist/ agar App Engine bisa melayani static files.